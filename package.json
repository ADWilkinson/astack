{
  "name": "astack-skills",
  "version": "0.8.0",
  "private": false,
  "description": "Skills for Claude Code and Codex that take product work from the thread to a proven, live release.",
  "license": "MIT",
  "repository": "https://github.com/ADWilkinson/astack",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "check": "bun scripts/check.ts && bun test tests/package.test.ts tests/install.test.ts && bun scripts/smoke.ts",
    "smoke": "bun scripts/smoke.ts",
    "test": "bun test",
    "validate": "bun scripts/check.ts",
    "metadata": "bun scripts/metadata.ts",
    "pack": "bun scripts/pack.ts",
    "build": "bun build src/cli.ts --target=node --format=esm --outfile=dist/astack.mjs",
    "prepack": "bun scripts/npm-prepack.ts"
  },
  "type": "module",
  "bin": {
    "astack": "dist/astack.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "dist/astack.mjs",
    "src/cli.ts",
    "skills/",
    "catalog.json",
    "plugin.json",
    ".claude-plugin/",
    ".codex-plugin/",
    "CHANGELOG.md"
  ],
  "keywords": [
    "claude-code",
    "codex",
    "agent-skills",
    "skills",
    "ai-agents",
    "shipping",
    "design",
    "deslop"
  ],
  "homepage": "https://github.com/ADWilkinson/astack"
}
