{
  "name": "astack-skills",
  "version": "0.5.0",
  "private": false,
  "description": "A standalone skill suite for context, creative craft, implementation, measurement and delivery.",
  "license": "MIT",
  "repository": "https://github.com/ADWilkinson/astack",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "check": "bun scripts/check.ts && bun test",
    "validate": "bun scripts/check.ts",
    "metadata": "bun scripts/metadata.ts",
    "pack": "bun scripts/pack.ts",
    "build": "bun build src/cli.ts --target=node --format=esm --outfile=dist/astack.mjs",
    "prepack": "bun scripts/npm-prepack.ts"
  },
  "type": "module",
  "bin": {
    "astack": "dist/astack.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "dist/astack.mjs",
    "src/cli.ts",
    "skills/",
    "catalog.json",
    "plugin.json",
    ".claude-plugin/",
    ".codex-plugin/",
    "docs/",
    "examples/",
    "evals/",
    "SCOPE.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "AGENTS.md"
  ]
}
